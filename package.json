{
  "name": "redseal-operations-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "pnpm --filter @redseal/server dev",
    "build": "tsc -b && vite build",
    "build:server": "pnpm --filter @redseal/server build",
    "build:all": "pnpm run build && pnpm run build:server",
    "lint": "eslint src vite.config.ts",
    "lint:server": "pnpm --filter @redseal/server lint",
    "lint:all": "pnpm run lint && pnpm run lint:server",
    "typecheck:server": "pnpm --filter @redseal/server typecheck",
    "preview": "vite preview",
    "test": "vitest run",
    "test:server": "pnpm --filter @redseal/server test",
    "test:all": "pnpm run test && pnpm run test:server",
    "seed:server": "pnpm --filter @redseal/server seed"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
