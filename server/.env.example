# Red Seal operations API configuration.
# Every value below is optional except SEED_PASSWORD in production.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# SQLite database file, or ':memory:' for an ephemeral instance.
DATABASE_URL=./data/redseal.db

# Browser origins permitted to call the API, comma separated.
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

LOG_LEVEL=info

# Session lifetime, in hours.
SESSION_TTL_HOURS=12

# Plot hold period, in days. Red Seal policy is seven days.
RESERVATION_HOLD_DAYS=7

# Sign-in lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Password for the seeded demonstration accounts.
# Required when NODE_ENV=production; the seed refuses to run without it.
SEED_PASSWORD=change-me-before-seeding
